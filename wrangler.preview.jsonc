{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tutor-zp-ua-preview",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  }
}
